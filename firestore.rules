rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Private Settings & Configuration
    match /users/{userId}/settings/{settingId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && incoming().userId == userId;
      allow delete: if false;
    }

    // User Private Financial Transactions (Strict User Isolation)
    match /users/{userId}/transactions/{transactionId} {
      allow read, list: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidId(transactionId)
        && incoming().userId == userId
        && incoming().id is string
        && incoming().tanggal is string
        && incoming().jenis in ['Pengeluaran', 'Pemasukan', 'Tarik Tunai', 'Setor Tunai']
        && incoming().judul is string
        && incoming().judul.size() > 0
        && incoming().judul.size() <= 200
        && incoming().nominal is number
        && incoming().nominal > 0
        && incoming().createdAt is number;

      allow update: if isOwner(userId)
        && isValidId(transactionId)
        && incoming().userId == userId
        && incoming().id == existing().id
        && incoming().jenis in ['Pengeluaran', 'Pemasukan', 'Tarik Tunai', 'Setor Tunai']
        && incoming().judul is string
        && incoming().judul.size() > 0
        && incoming().judul.size() <= 200
        && incoming().nominal is number
        && incoming().nominal > 0;

      allow delete: if isOwner(userId);
    }
  }
}
